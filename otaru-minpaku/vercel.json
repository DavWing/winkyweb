{
  "name": "otaru-minpaku",
  "version": 2,
  "public": true,
  "buildCommand": "",
  "outputDirectory": "./",
  "env": {},
  "regions": ["sin1"],
  "functions": {},
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ]
}
